<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_category_general">

        <ListPreference
            android:key="app_language"
            android:title="@string/settings_language"
            android:summary="%s"
            android:entries="@array/language_display_names"
            android:entryValues="@array/language_values"
            android:defaultValue="sr"
            app:useSimpleSummaryProvider="false" />

        <ListPreference
            android:key="distance_units"
            android:title="@string/settings_units"
            android:summary="%s"
            android:entries="@array/units_display_names"
            android:entryValues="@array/units_values"
            android:defaultValue="km" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_notifications">

        <SwitchPreferenceCompat
            android:key="notifications_enabled"
            android:title="@string/settings_notifications"
            android:summary="@string/settings_notifications_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>